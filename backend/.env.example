# Defina estas variáveis no serviço/container. Este arquivo NÃO é carregado automaticamente.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=www.salaopro.site,salaopro.site
CORS_ALLOWED_ORIGINS=https://www.salaopro.site,https://salaopro.site
CSRF_TRUSTED_ORIGINS=https://www.salaopro.site,https://salaopro.site
DJANGO_SECURE_SSL_REDIRECT=True
# Habilite apenas com proxy confiável que substitui X-Forwarded-Proto.
DJANGO_TRUST_PROXY=False
DJANGO_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# PostgreSQL no mesmo servidor Vultr: preserve nome, usuário, senha e porta atuais.
DB_ENGINE=postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
# Alias confirmado do PostgreSQL na rede Docker compartilhada com o backend.
# Exemplo para esta instalação; conferir o HOST efetivo antes da publicação.
DB_HOST=db
DB_PORT=5432
# Mantém negociação TLS compatível com conexão local. Preserve a política existente.
# Para conexão remota com CA configurada, use verify-full e DB_SSLROOTCERT.
DB_SSLMODE=prefer
# DB_SSLROOTCERT=/caminho/ca.crt
DB_CONNECT_TIMEOUT=10
DB_CONN_MAX_AGE=60

# Entrypoint novo: 1 mantém migrações no início do único container backend.
# Com migrações executadas separadamente, use 0; ele recusará iniciar com migrações pendentes.
RUN_MIGRATIONS=1

# Não bloqueia a resposta do agendamento enquanto e-mail/WhatsApp são enviados.
AGENDA_NOTIFICATIONS_ASYNC=True

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Use o remetente já autorizado pelo seu provedor SMTP.
DEFAULT_FROM_EMAIL=
EMAIL_ALERT_TO=
PUBLIC_FRONTEND_URL=https://www.salaopro.site
# Tempo de validade do link de recuperação, em segundos (30 minutos).
PASSWORD_RESET_TIMEOUT=1800

WAHA_API_URL=http://waha:3000
WAHA_API_KEY=
WAHA_SESSION=default

MERCADOPAGO_ACCESS_TOKEN=
PERMITIR_PAGAMENTOS=False

# Cache compartilhado para rate limit (rede interna do Docker)
CACHE_URL=redis://redis:6379/1

AUTH_IP_RATE_LIMIT=20/min
AUTH_ACCOUNT_RATE_LIMIT=5/min
