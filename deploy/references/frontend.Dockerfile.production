# Referência recebida do usuário em 20/09/2026.
# Origem: /root/SaaS_barbearia_pro/frontend/Dockerfile no servidor.
# Não é o Dockerfile local de implantação; depende do nginx.conf de produção.

FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
ENV VITE_API_URL=/
RUN npm run build

FROM nginx:alpine
RUN rm /etc/nginx/conf.d/default.conf
RUN sed -i 's/user  nginx;/user  root;/' /etc/nginx/nginx.conf
COPY nginx.conf /etc/nginx/conf.d/
COPY --from=build /app/dist /usr/share/nginx/html
RUN mkdir -p /app/media/profissionais && chmod -R 755 /app/media
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
